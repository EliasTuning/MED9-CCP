# Full path to the J2534 DLL (32-bit when using a 32-bit Python).
J2534_DLL=C:/Program Files (x86)/OpenECU/OpenPort 2.0/drivers/openport 2.0/op20pt32.dll

# CAN bitrate in kbit/s (100 -> 100000 bit/s).
CAN_SPEED=100

# CCP session used by main.py. See README.md for MED9.1 / MED9.2 IDs.
CCP_TX=0x7C3
CCP_RX=0x7C4
CCP_STATION_ADDRESS=0x12ED
CCP_TIMEOUT=1.0

# ident_ccp.py: standard 11-bit CAN ends at 0x7FF
IDENT_ID_MAX=0x7FF
# How long to listen for a reply after each CONNECT (seconds)
IDENT_LISTEN_S=0.05

# CAN IDs to ignore while scanning (comma-separated, hex or decimal).
IGNORE_CAN_IDS=
